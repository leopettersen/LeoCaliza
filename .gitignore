# ==========================================
# Frontend: React + Vite (Node.js)
# ==========================================
# Dependências
node_modules/
/.pnp
.pnp.js

# Build e Produção
dist/
dist-ssr/
build/

# Logs do Node
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Variáveis de ambiente locais (Não comite secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Cache do Vite / ferramentas
.eslintcache
.stylelintcache
.vite/

# ==========================================
# Backend: Spring Boot (Java / Maven / Gradle)
# ==========================================
# Arquivos compilados
*.class

# Logs do Java
*.log
*.log.*

# Diretórios de build (Maven e Gradle)
target/
build/
.gradle/
bin/
out/

# Ignorar arquivos JAR, WAR, EAR e ZIP gerados, exceto os wrappers
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
!gradle/wrapper/gradle-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar

# ==========================================
# Configurações de IDEs e Editores
# ==========================================
# VS Code
.vscode/
*.code-workspace
.history/

# IntelliJ IDEA (WebStorm, IntelliJ, etc)
.idea/
*.iml
*.iws
out/
