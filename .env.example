# Variáveis do docker-compose. Todas têm valor padrão: o .env só é necessário para mudar algo.
#   cp .env.example .env

# Banco PostgreSQL local (serviço "db")
POSTGRES_DB=leocaliza
POSTGRES_USER=leocaliza
POSTGRES_PASSWORD=leocaliza

# Para usar o Supabase em vez do banco local, troque as três linhas abaixo
# pelos dados do seu projeto (Project Settings > Database > Session pooler).
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/leocaliza
SPRING_DATASOURCE_USERNAME=leocaliza
SPRING_DATASOURCE_PASSWORD=leocaliza

# Gere um segredo forte com: openssl rand -base64 32
JWT_SECRET=

# Portas expostas na máquina
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Endereços vistos pelo navegador
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080
