# Copie este arquivo para .env e preencha com os dados do SEU projeto Supabase.
# O .env está no .gitignore e nunca deve ser commitado.
#
#   cp backend/.env.example backend/.env

# Banco de dados
# Supabase > Project Settings > Database > Connection string (Session pooler)
# A senha vem de "Reset database password" (ela só é exibida uma vez).
# Se a senha tiver caracteres especiais (#, =, :, espaço), coloque entre aspas.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<ref-do-projeto>
SPRING_DATASOURCE_PASSWORD=

# JPA / Hibernate: "update" cria/atualiza as tabelas automaticamente na subida.
JPA_DDL_AUTO=update

# Origem permitida no CORS (front-end Vite).
FRONTEND_URL=http://localhost:5173
